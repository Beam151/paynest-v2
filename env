#--------------------------------------------------------------------
# ตัวอย่างค่าตั้งของเครื่อง — คัดลอกเป็น .env แล้วแก้เฉพาะที่ต้องการ (ห้าม commit ไฟล์ .env)
#
#   cp env .env
#
# ค่าที่ไม่ได้เปิด (มี # นำหน้า) ใช้ค่าตั้งต้นที่ปลอดภัยใน app/Config/Paynest.php
# Telegram · เรื่องที่แจ้งเตือน · บัญชีรับเงิน ตั้งในหน้าเว็บ ไม่ใช่ที่นี่
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# โหมดการทำงาน
#   production  = เซิร์ฟเวอร์จริง: บังคับ Google Authenticator กับบัญชีส่วนกลาง
#   development = เครื่องนักพัฒนา: ไม่บังคับ 2FA (ยืนยันเรื่องอันตรายด้วยรหัสผ่านแทน)
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# ที่อยู่เว็บ (ใช้แค่ตอนเฟรมเวิร์กต้องสร้างลิงก์ — ลงท้ายด้วย /)
#--------------------------------------------------------------------

app.baseURL = 'https://paynest.example.com/'

#--------------------------------------------------------------------
# ฐานข้อมูล MariaDB 10.4+ หรือ MySQL 8.0.16+ (สร้างฐานข้อมูลว่างแบบ utf8mb4 ไว้ก่อน แล้วรัน php spark app:install)
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.port     = 3306
database.default.database = paynest
database.default.username = paynest
database.default.password = ''

#--------------------------------------------------------------------
# ระบบ (ไม่ตั้ง = ใช้ค่าตั้งต้น)
#--------------------------------------------------------------------

# จำนวน reverse proxy / CDN ที่อยู่หน้าเว็บเซิร์ฟเวอร์ — ไม่นับ nginx/Apache ที่รัน PHP เอง
#   nginx + PHP-FPM บนเครื่องเดียว (aaPanel แบบปกติ) = 0
#   มี Cloudflare (เมฆสีส้ม) หรือ load balancer อยู่หน้าเว็บ = 1 · สองชั้น = 2
# ตั้งน้อยไป = ทุกคนเป็น IP ของ proxy (คนเดารหัสผิดคนเดียว ทุกร้านโดนล็อก) · ตั้งมากไป = ปลอม IP หนี rate limit ได้
# paynest.trustProxy = 0

# ชื่อที่ขึ้นในแอป Google Authenticator
# paynest.appName = 'ระบบจัดการร้าน'

# ล็อกอินหมดอายุ (เจ้าของระบบตัดสินใจให้ล็อกอินใหม่วันละครั้ง)
# paynest.jwtExpiresIn = 24h

# วันครบกำหนดชำระ = วันจบรอบ + กี่วัน
# paynest.invoiceDueDays = 7

# ที่เก็บ secrets.json · รหัสแอดมินเริ่มต้น · สลิป/QR · ไฟล์สำรอง (ค่าตั้งต้น writable/data)
# paynest.dataDir = writable/data
# paynest.backupDir =
# paynest.backupKeepDays = 30

# ── ไม่ต้องตั้ง: ระบบสุ่มให้เองแล้วเก็บใน <dataDir>/secrets.json ──
# ตั้งเองได้ถ้าเก็บ secret แยก (ค่าใน env ชนะไฟล์เสมอ · ต้องยาว ≥ 32 ตัว · openssl rand -base64 48)
# paynest.jwtSecret =
# paynest.encryptionKey =

# ── ไม่ต้องตั้ง: แอดมินคนแรกได้รหัสสุ่มในไฟล์ <dataDir>/initial-admin-password.txt ──
# paynest.seedSuperAdminUser = superadmin
# paynest.seedSuperAdminPass =

