{
    "name": "beam151/paynest-v2",
    "description": "ระบบจัดการร้าน — เรียกเก็บส่วนต่างจากยอดขายของร้านในเครือรายครึ่งเดือน (CodeIgniter 4 + MySQL/MariaDB)",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "chillerlan/php-qrcode": "^5.0",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:smoke",
            "@test:pentest"
        ],
        "test:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "node tests/e2e/smoke.mjs"
        ],
        "test:pentest": [
            "Composer\\Config::disableProcessTimeout",
            "node tests/e2e/pentest.mjs"
        ],
        "test:unit": "phpunit"
    },
    "scripts-descriptions": {
        "test": "ทดสอบทั้งหมด (smoke + pentest) บนฐานข้อมูลเทสต์แยก — ต้องมี Node ≥ 18 และ MySQL/MariaDB ดู tests/README.md",
        "test:smoke": "ทดสอบทุกฟีเจอร์ผ่าน HTTP (440+ ข้อ)",
        "test:pentest": "ลองโจมตีระบบจริง (90+ แบบ) — ทุกข้อต้องกันได้",
        "test:unit": "PHPUnit"
    }
}
